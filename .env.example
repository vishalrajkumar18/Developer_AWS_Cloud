# ============================================================
# CivicTrack – Environment Configuration (.env)
# ============================================================

# 1. Flask REST API Backend
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=generate-a-secure-random-secret-key-for-flask
JWT_SECRET_KEY=generate-a-secure-jwt-secret-key-for-tokens
PORT=5000

# 2. MySQL Database
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=civictrack_db
MYSQL_USER=civic_user
MYSQL_PASSWORD=civic_password
MYSQL_HOST=mysql
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://civic_user:civic_password@mysql:3306/civictrack_db

# 3. Firebase Authentication (Google OAuth)
VITE_FIREBASE_API_KEY=AIzaSyB3civicTrackKey9812470129481234
VITE_FIREBASE_AUTH_DOMAIN=civictrack-portal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=civictrack-portal
VITE_FIREBASE_STORAGE_BUCKET=civictrack-portal.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=782194012849
VITE_FIREBASE_APP_ID=1:782194012849:web:38bdf80ea5e91a3160

# 4. Frontend API Connection
VITE_API_URL=/api

# 5. Monitoring Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
PROMETHEUS_SCRAPE_INTERVAL=15s

# 6. AWS Deployment (for CI/CD secrets)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=
# EC2_HOST=
