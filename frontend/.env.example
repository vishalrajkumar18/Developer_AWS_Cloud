# ============================================================
# CivicTrack – Firebase Authentication Environment Variables
# ============================================================
# 1. Create a Firebase project at https://console.firebase.google.com/
# 2. Go to Project Settings > General > "Your apps" > Add Web App
# 3. Enable Authentication > Sign-in method > Google
# 4. Copy your web app config values into this file and rename it to .env
# ============================================================

VITE_FIREBASE_API_KEY=AIzaSyExampleKeyNotReal1234567890
VITE_FIREBASE_AUTH_DOMAIN=civictrack-portal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=civictrack-portal
VITE_FIREBASE_STORAGE_BUCKET=civictrack-portal.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
